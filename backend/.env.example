# Server Configuration
NODE_ENV=development
PORT=5000

# Relational Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/codecall

# Redis (Used for BullMQ background jobs)
REDIS_URL=redis://localhost:6379

# JWT secrets (must be at least 32 characters long)
JWT_ACCESS_SECRET=your_jwt_access_secret_with_32_chars_or_more
JWT_REFRESH_SECRET=your_jwt_refresh_secret_with_32_chars_or_more
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
REFRESH_TOKEN_EXPIRY_MS=604800000

# Client URL references
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Code Execution API (Judge0 API endpoint, defaults to their public CE URL)
JUDGE0_API_URL=https://ce.judge0.com

# SMTP configuration for transaction emails (verification/reset password)
SMTP_USER=your_smtp_email@gmail.com
SMTP_PASS=your_smtp_app_password

# OAuth Configuration (Optional — OAuth routes fail gracefully if omitted)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Render service external deployment URL (Optional, for OAuth callback redirect resolution)
RENDER_EXTERNAL_URL=http://localhost:5000

# Sentry monitoring (Optional)
SENTRY_DSN=
